# Copy to .env and fill in real values. NEVER commit .env.

# ---- Shared ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgresql://webide:webide@127.0.0.1:5432/webide

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- apps/api ----
API_PORT=3001
API_HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:3001
# Comma-separated list of allowed browser origins (the Next.js dev server)
WEB_ORIGIN=http://localhost:3000

# 32+ byte random secret used to sign session CSRF tokens and sign
# short-lived runner capability tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
# Separate secret shared ONLY between api and runner (never exposed to web).
RUNNER_SHARED_SECRET=change-me-generate-with-openssl-rand-hex-32

# Absolute path on the API host where workspace files are stored.
WORKSPACE_STORAGE_ROOT=./.local-data/workspaces

# ---- apps/runner ----
RUNNER_PORT=3002
RUNNER_HOST=127.0.0.1
RUNNER_SHARED_SECRET=change-me-generate-with-openssl-rand-hex-32
# OCI runtime for sandboxes: "" (default docker runtime) or "runsc" (gVisor)
# or "kata" (Kata Containers) in production.
SANDBOX_OCI_RUNTIME=
# Where sandbox container image tags live. Images must be built via
# `pnpm runner:build-images`.
SANDBOX_IMAGE_PREFIX=webide-runtime

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:3001
