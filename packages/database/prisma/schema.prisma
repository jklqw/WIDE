generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  emailNorm    String       @unique @map("email_norm")
  passwordHash String       @map("password_hash")
  displayName  String       @map("display_name")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sessions      Session[]
  workspaces    Workspace[]      @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  executionJobs ExecutionJob[]
  terminalSessions TerminalSession[]
  auditEvents   AuditEvent[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id                String   @id @default(cuid())
  ownerId           String   @map("owner_id")
  name              String
  description       String?
  templateId        String   @default("blank") @map("template_id")
  runtimePreference String?  @map("runtime_preference")
  storageKey        String   @unique @map("storage_key")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          WorkspaceMember[]
  executionJobs    ExecutionJob[]
  terminalSessions TerminalSession[]
  auditEvents      AuditEvent[]

  @@index([ownerId, updatedAt])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  role        String @default("member")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

enum ExecutionStatus {
  QUEUED
  PREPARING
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
  RESOURCE_LIMITED
}

model ExecutionJob {
  id                 String           @id @default(cuid())
  workspaceId        String           @map("workspace_id")
  userId             String           @map("user_id")
  sourcePath         String           @map("source_path")
  languageId         String           @map("language_id")
  runtimeImageId     String?          @map("runtime_image_id")
  status             ExecutionStatus  @default(QUEUED)
  queuedAt           DateTime         @default(now()) @map("queued_at")
  startedAt          DateTime?        @map("started_at")
  finishedAt         DateTime?        @map("finished_at")
  compileDurationMs  Int?             @map("compile_duration_ms")
  durationMs         Int?             @map("duration_ms")
  exitCode           Int?             @map("exit_code")
  resourceLimitReason String?         @map("resource_limit_reason")
  outputBytes        Int              @default(0) @map("output_bytes")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, queuedAt(sort: Desc)])
  @@index([userId, status])
  @@map("execution_jobs")
}

model TerminalSession {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  userId        String    @map("user_id")
  sandboxLeaseId String?  @map("sandbox_lease_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt     DateTime  @map("expires_at")
  closedAt      DateTime? @map("closed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([expiresAt])
  @@map("terminal_sessions")
}

model AuditEvent {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  workspaceId  String?  @map("workspace_id")
  action       String
  outcome      String
  metadataJson Json?    @map("metadata_json")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("audit_events")
}
